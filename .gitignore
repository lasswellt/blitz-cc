# Environment
.env
.env.local

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Debug logs
*.log

# Python bytecode cruft (scripts/*.py)
__pycache__/
*.pyc

# Claude Code local settings
.claude/settings.local.json

# Scheduled-task runtime lock (machine-local, not committed)
.claude/scheduled_tasks.lock

# Session state (machine-local, not committed)
.cc-sessions/

# Sprint execution artifacts (machine-local, not committed)
sprints/
sprint-registry.json

# Dev-only artifacts generated by skills (this is the plugin repo — these are for
# plugin development on this machine, NOT shipped with the plugin)
docs/_research/
docs/roadmap/
docs/retrospective/
docs/audits/
docs/metrics/
docs/sweeps/

# Legacy temp files from skill execution (migrated to .cc-sessions/)
/tmp/

# Installer
installer/node_modules/
.cc-sessions/KNOWLEDGE.md

# compress skill local backups (git history is the backup)
*.original

# audit skill output (generated; not source)
.review/

# Skill-generated artifacts at repo root (this is the plugin repo — these are
# produced by running blitz skills here, NOT plugin source). Root-anchored so
# tracked fixtures like .ui-audit.json.example are unaffected.
/CODEBASE-MAP.md
/DESIGN.md
/.ui-audit.json
/.quality-metrics.json
/KNOWLEDGE.md
/todos.jsonl
/.blitz-cache/
firebase-debug.log
firebase-debug.*.log
