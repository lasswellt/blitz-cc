{
  "typescript": {
    "command": "${user_config.lsp_typescript}",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact",
      ".mts": "typescript",
      ".cts": "typescript",
      ".js": "javascript",
      ".jsx": "javascriptreact",
      ".mjs": "javascript",
      ".cjs": "javascript"
    }
  },
  "python": {
    "command": "${user_config.lsp_python}",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".py": "python",
      ".pyi": "python"
    }
  },
  "rust": {
    "command": "${user_config.lsp_rust}",
    "args": [],
    "extensionToLanguage": {
      ".rs": "rust"
    }
  },
  "go": {
    "command": "${user_config.lsp_go}",
    "args": ["serve"],
    "extensionToLanguage": {
      ".go": "go"
    }
  }
}
